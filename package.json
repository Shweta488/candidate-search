{
  "name": "candidate-search-recruiter-search",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress/tsconfig.json",
    "lint": "eslint .",
    "test": "jest --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "e2e": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "e2e:open": "env -u ELECTRON_RUN_AS_NODE cypress open",
    "eval:search": "node scripts/eval-search.ts",
    "replay:stripe": "node scripts/replay-stripe-events.ts",
    "check:secrets": "jest --config jest.security.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@supabase/supabase-js": "2.117.1",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "cypress": "15.21.1",
    "cypress-axe": "1.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jest": "30.5.2",
    "supabase": "2.119.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "unrs-resolver": false,
    "@parcel/watcher": false,
    "cypress@15.21.1": true
  }
}
