# Every environment variable the app reads (docs/LLD.md section 9). No values here.

# Written to .env.local by `make setup` (scripts/write-env.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Export these in your shell before `make dev`; never write them to a file
ANTHROPIC_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional
STRIPE_WEBHOOK_TOLERANCE_SECONDS=
APP_URL=
