flowchart LR
    Browser["Browser<br/>(recruiter)"]
    Stripe["Stripe<br/>(webhook events)"]

    App["Next.js app<br/>pages + API routes"]

    Auth["Supabase Auth"]
    DB[("Postgres<br/>(local Supabase)")]
    LLM["Claude Haiku<br/>(brief to filters)"]

